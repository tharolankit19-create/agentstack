{
  "name": "kryxai-launch-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts --no-open",
    "still": "NODE_OPTIONS=--require=./scripts/render-network-shim.cjs remotion still src/index.ts KryxLaunch",
    "render": "NODE_OPTIONS=--require=./scripts/render-network-shim.cjs remotion render src/index.ts KryxLaunch out/kryxai-launch.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k"
  },
  "dependencies": {
    "@remotion/cli": "4.0.524",
    "@remotion/media": "4.0.524",
    "@remotion/transitions": "4.0.524",
    "remotion": "4.0.524",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.3"
  }
}
