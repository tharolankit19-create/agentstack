{
  "name": "agentstack",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing Agents Army — a head agent that messages you, and the squads that report to it.",
  "workspaces": [
    "apps/web",
    "apps/hermes-core"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "dev:agent": "npm run dev --workspace apps/hermes-core",
    "build": "npm run build --workspace apps/web",
    "build:agent": "npm run build --workspace apps/hermes-core",
    "typecheck": "npm run typecheck --workspace apps/hermes-core && npm run typecheck --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "bundle": "npm run bundle --workspace apps/web",
    "schema": "node scripts/build-schema.mjs",
    "cron:secret": "node scripts/cron-secret.mjs",
    "test:v2": "node --test tests/v2-*.test.cjs",
    "test:v2:ui": "node --test tests/browser/jobs-ui.test.cjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "esbuild": "0.28.2",
    "playwright": "^1.62.1"
  }
}
