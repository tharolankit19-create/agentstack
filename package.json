{
  "name": "agentstack",
  "version": "1.0.0",
  "private": true,
  "description": "KryxAI — your always-on AI marketing operator.",
  "workspaces": [
    "apps/web",
    "apps/hermes-core"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "dev:agent": "npm run dev --workspace apps/hermes-core",
    "build": "npm run build --workspace apps/web",
    "build:agent": "npm run build --workspace apps/hermes-core",
    "typecheck": "npm run typecheck --workspace apps/hermes-core && npm run typecheck --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "bundle": "npm run bundle --workspace apps/web",
    "schema": "node scripts/build-schema.mjs",
    "cron:secret": "node scripts/cron-secret.mjs",
    "test": "node --import ./tests/operator/register.mjs --test tests/operator/*.test.ts && node --test apps/computer-runtime/*.test.mjs",
    "test:playwright": "playwright test --config tests/operator/playwright.config.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@playwright/test": "1.62.1",
    "@sparticuz/chromium": "143.0.4",
    "esbuild": "0.28.1",
    "playwright": "^1.62.1",
    "prettier": "3.6.2"
  }
}
