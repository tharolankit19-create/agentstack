{
  "id": "lead-agent",
  "name": "Lead Agent",
  "description": "Finds people who match your ICP every morning and writes the first line for each.",
  "category": "Sales",
  "icon": "🎯",
  "replaces": {
    "tools": [
      "Apollo",
      "Clay"
    ],
    "monthlyUsd": 149
  },
  "frequency": "0 8 * * 1-5",
  "model": "gpt-4o-mini",
  "temperature": 0.6,
  "maxIterations": 10,
  "tools": [
    "find_leads",
    "draft",
    "list_prompts",
    "read_page"
  ],
  "prompts": [
    "system",
    "email"
  ],
  "scheduledTask": "Find new people matching the ICP, then write an opening email for the strongest matches.",
  "examples": [
    "Find 10 leads matching my ICP",
    "Write the opening email for lead 1",
    "Which of these leads is the best fit, and why?"
  ],
  "settings": [
    {
      "key": "icp",
      "label": "Who you want to reach",
      "type": "textarea",
      "placeholder": "Heads of Growth at 20-200 person B2B SaaS in the US",
      "required": true
    },
    {
      "key": "offer",
      "label": "What you are selling",
      "type": "textarea",
      "placeholder": "AgentStack — replace your SaaS stack with agents",
      "required": true
    },
    {
      "key": "senderName",
      "label": "Your name",
      "type": "text",
      "placeholder": "Ankit",
      "required": true
    },
    {
      "key": "dailyLimit",
      "label": "Leads per run",
      "type": "select",
      "options": [
        "10",
        "25",
        "50"
      ],
      "default": "25"
    },
    {
      "key": "tone",
      "label": "Email tone",
      "type": "select",
      "options": [
        "Direct",
        "Casual",
        "Formal"
      ],
      "default": "Direct"
    },
    {
      "key": "frequency",
      "label": "How often it runs",
      "type": "select",
      "options": [
        "Every weekday 9am",
        "Every day 9am",
        "Manual only"
      ],
      "default": "Every weekday 9am"
    }
  ],
  "secrets": [
    {
      "key": "OPENAI_API_KEY",
      "label": "OpenAI API key",
      "required": true
    },
    {
      "key": "APOLLO_API_KEY",
      "label": "Apollo API key",
      "required": true
    }
  ]
}
