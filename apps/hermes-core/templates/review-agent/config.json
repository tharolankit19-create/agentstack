{
  "id": "review-agent",
  "name": "Review Agent",
  "description": "Watches your review pages and drafts a reply to every new review.",
  "category": "Support",
  "icon": "⭐",
  "replaces": {
    "tools": [
      "Birdeye",
      "Reputation.com"
    ],
    "monthlyUsd": 299
  },
  "frequency": "0 */6 * * *",
  "model": "gpt-4o-mini",
  "temperature": 0.5,
  "maxIterations": 10,
  "tools": [
    "check_reviews",
    "draft",
    "list_prompts",
    "notify"
  ],
  "prompts": [
    "system",
    "reply"
  ],
  "scheduledTask": "Check the review page for reviews with no reply, draft a reply for each, and flag anything low-rated.",
  "examples": [
    "Check for new reviews and draft replies",
    "Draft a reply to the most recent 2-star review",
    "Summarise what people complain about most"
  ],
  "settings": [
    {
      "key": "reviewUrl",
      "label": "Review page URL",
      "type": "url",
      "placeholder": "https://www.g2.com/products/your-product/reviews",
      "help": "G2, Capterra, Trustpilot or Product Hunt.",
      "required": true
    },
    {
      "key": "brandName",
      "label": "Brand name",
      "type": "text",
      "required": true
    },
    {
      "key": "brandTone",
      "label": "Reply tone",
      "type": "select",
      "options": [
        "Warm",
        "Professional",
        "Direct",
        "Apologetic"
      ],
      "default": "Warm",
      "required": true
    },
    {
      "key": "signature",
      "label": "Sign replies as",
      "type": "text",
      "placeholder": "— Ankit, founder"
    },
    {
      "key": "escalateBelow",
      "label": "Flag reviews at or below",
      "type": "select",
      "options": [
        "2 stars",
        "3 stars",
        "Never flag"
      ],
      "default": "3 stars"
    },
    {
      "key": "frequency",
      "label": "How often it runs",
      "type": "select",
      "options": [
        "Every day 9am",
        "Every weekday 9am",
        "Manual only"
      ],
      "default": "Every day 9am"
    }
  ],
  "secrets": [
    {
      "key": "OPENAI_API_KEY",
      "label": "OpenAI API key",
      "required": true
    },
    {
      "key": "SLACK_WEBHOOK_URL",
      "label": "Slack webhook",
      "help": "Optional. Where flagged reviews get pinged."
    }
  ]
}
