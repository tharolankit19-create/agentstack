# hermes-core — a single deployed agent.
#
# AgentStack writes every one of these as an encrypted Vercel environment
# variable at deploy time. You only fill this file in when running the engine
# locally with `npm run dev:agent`.

# ---- Identity (set by the deploy pipeline) ----
ACTIVE_TEMPLATE=content-agent
AGENT_ID=
# Shared secret guarding /api/run and /api/chat. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_TOKEN=
# Where finished runs are reported. Leave blank to run detached.
AGENTSTACK_CALLBACK_URL=
# Set to "true" to make the agent refuse to run (the dashboard's Stop toggle).
AGENT_PAUSED=false

# ---- Model ----
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint: OpenRouter, Nous Portal, a local server.
OPENAI_BASE_URL=
# Overrides the model named in the template's config.json.
AGENT_MODEL=

# ---- Template settings (SETTING_<UPPER_SNAKE_CASE of the config key>) ----
SETTING_WEBSITE_URL=
SETTING_TONE=Direct
SETTING_AUDIENCE=
SETTING_FREQUENCY=Every weekday 9am
SETTING_AUTO_PUBLISH=No — draft only

# ---- Publishing (content-agent, optional) ----
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# ---- Leads (lead-agent) ----
APOLLO_API_KEY=

# ---- Vercel Cron ----
CRON_SECRET=
