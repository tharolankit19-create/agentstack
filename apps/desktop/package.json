{
  "name": "kryx-desktop",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "KryxAI desktop runtime — the local execution layer for the Kryx marketing agent army.",
  "main": "src/main.mjs",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --dir",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "ai.kryx.desktop",
    "productName": "Kryx",
    "asar": true,
    "files": [
      "src/**/*",
      "build/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Kryx Desktop",
        "schemes": ["kryx"]
      }
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "minimumSystemVersion": "13.0"
    },
    "dmg": {
      "sign": false
    }
  }
}
