{
  "name": "kryx-desktop",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "KryxAI desktop runtime — the local execution layer for the Kryx marketing agent army.",
  "main": "src/main.mjs",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --dir",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "ai.kryx.desktop",
    "productName": "Kryx",
    "asar": true,
    "files": [
      "src/**/*",
      "build/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Kryx Desktop",
        "schemes": [
          "kryx"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "minimumSystemVersion": "13.0"
    },
    "dmg": {
      "sign": false
    },
    "asarUnpack": [
      "node_modules/@opensymph/open-computer-use/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "browser-extension",
        "to": "browser-extension"
      }
    ],
    "publish": null,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Kryx-Windows-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "artifactName": "Kryx-Linux-${version}.${ext}"
    }
  },
  "dependencies": {
    "@opensymph/open-computer-use": "1.2.0",
    "ws": "8.18.3"
  }
}
