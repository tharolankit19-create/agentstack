# AgentStack — the SaaS.
#
# Copy to .env.local for development. In production every one of these lives in
# Vercel's environment variables, which is the only place they should exist.

# ---- App ----------------------------------------------------------------
# Your production URL. Used for OAuth redirects, checkout returns, and the
# callback URL written into every agent deployment. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase -----------------------------------------------------------
# Project settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses RLS. Server only — never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Secret vault -------------------------------------------------------
# Encrypts customer API keys before they are stored. 32 bytes.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this makes every stored key unreadable. Customers would have to
# re-enter them, so treat it as permanent.
SECRETS_ENCRYPTION_KEY=

# ---- Dodo Payments ------------------------------------------------------
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=
# "test" while you are building, "live" when you are selling.
DODO_ENVIRONMENT=test
# RECURRING (monthly) product ids from your Dodo dashboard, one per plan.
NEXT_PUBLIC_DODO_PRODUCT_STARTER=
NEXT_PUBLIC_DODO_PRODUCT_PRO=

# ---- Vercel (agent deployments) -----------------------------------------
# Token that creates the projects your customers' agents run in.
# vercel.com/account/tokens
VERCEL_API_TOKEN=
# Only if the agents should live under a team rather than your personal scope.
VERCEL_TEAM_ID=

# ---- Custom Agent Builder ------------------------------------------------
# Fallback key for the Pro "paste any tool's URL" builder, used when a customer
# has not yet given us an OpenAI key of their own. Leave blank to require one.
DEMO_OPENAI_API_KEY=
# Model that writes the generated agent's instructions.
CUSTOM_AGENT_MODEL=gpt-4o-mini
# Optional: point everything at an OpenAI-compatible endpoint instead.
OPENAI_BASE_URL=

# ---- Marketing ----------------------------------------------------------
NEXT_PUBLIC_FOUNDER_NAME=
NEXT_PUBLIC_TWITTER_HANDLE=
NEXT_PUBLIC_SUPPORT_EMAIL=
