# AgentStack — the SaaS.
#
# Copy to .env.local for development. In production every one of these lives in
# Vercel's environment variables, which is the only place they should exist.

# ---- App ----------------------------------------------------------------
# Your production URL. Used for OAuth redirects, checkout returns, and the
# callback URL written into every agent deployment. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase -----------------------------------------------------------
# Project settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses RLS. Server only — never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Which Postgres schema the tables live in. Leave unset unless you changed it:
# the migrations create `agentstack`, so that is the default. Whatever it is,
# it must also be listed under Settings → API → Exposed schemas, or every
# query comes back PGRST106.
# NEXT_PUBLIC_SUPABASE_SCHEMA=agentstack

# ---- Credit packs (Dodo product ids) ------------------------------------
# One product per pack, created in Dodo as a ONE-TIME payment rather than a
# subscription — the whole model is that a founder tops up and stops without
# cancelling. The webhook reads the pack from checkout metadata, not from the
# price, so changing a price later cannot silently grant the wrong number of
# credits. Leave these blank and the packs show a clear "not configured yet".
NEXT_PUBLIC_DODO_PACK_STARTER=
NEXT_PUBLIC_DODO_PACK_WORKING=
NEXT_PUBLIC_DODO_PACK_HEAVY=

# ---- Monid (cost-capped data tools) ------------------------------------
# The built-in squads use the platform Monid pool for leads, company data,
# social listening, jobs, SEO signal and page extraction.
#
# One key is enough:
MONID_API_KEY=
#
# Optional reliability backups. The runtime recognises MONID_API_KEY1 through
# MONID_API_KEY100 automatically, deduplicates them, and temporarily benches a
# key that is revoked or hits a Monid infrastructure failure.
MONID_API_KEY1=
MONID_API_KEY2=
# ...
# MONID_API_KEY100=
#
# IMPORTANT: backup keys are NOT used to bypass a Monid workspace budget,
# payment/quota response or rate limit. Those stop the run. Use multiple keys
# only when your Monid account/workspace permits it and the keys are legitimately
# funded/authorized for the same platform workload.
#
# Autonomous jobs also enforce endpoint price caps and small result limits.

# ---- Telegram (the head agent's channel) --------------------------------
# Ours, not the customer's — this is the number they message. Create a bot
# with @BotFather, then register the webhook so replies reach us:
#
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#     -d "url=https://your-app.com/api/telegram/webhook" \
#     -d "secret_token=<TELEGRAM_WEBHOOK_SECRET>"
#
# The secret is echoed back by Telegram in a header and is what proves an
# incoming request really came from them. Generate one the same way as the
# encryption key below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Shown to customers so they know which bot to open. Without the @.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# ---- Instant access -----------------------------------------------------
# Clicking a plan turns it on for this many minutes before payment is
# required. Set NEXT_PUBLIC_INSTANT_TRIAL=off to disable it entirely.
INSTANT_TRIAL_MINUTES=60
# NEXT_PUBLIC_INSTANT_TRIAL=off

# ---- Secret vault -------------------------------------------------------
# Encrypts customer API keys before they are stored. 32 bytes.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this makes every stored key unreadable. Customers would have to
# re-enter them, so treat it as permanent.
SECRETS_ENCRYPTION_KEY=

# ---- Dodo Payments ------------------------------------------------------
# Current PAYG setup: ONE one-time $5 product. Larger top-ups increase product
# quantity; the webhook converts quantity back to Kryx credits.
DODO_PAYMENTS_API_KEY=
DODO_CREDIT_PRODUCT_ID=
# Dodo's current name for the endpoint signing secret:
DODO_PAYMENTS_WEBHOOK_KEY=
# "test_mode" while building, "live_mode" in production.
DODO_PAYMENTS_ENVIRONMENT=test_mode

# ---- Vercel (agent deployments) -----------------------------------------
# Token that creates the projects your customers' agents run in.
# vercel.com/account/tokens
VERCEL_API_TOKEN=
# Only if the agents should live under a team rather than your personal scope.
VERCEL_TEAM_ID=

# ---- Custom Agent Builder ------------------------------------------------
# Fallback key for the Pro "paste any tool's URL" builder, used when a customer
# has not yet given us an OpenAI key of their own. Leave blank to require one.
DEMO_OPENAI_API_KEY=
# Model that writes the generated agent's instructions.
CUSTOM_AGENT_MODEL=gpt-4o-mini
# Optional: point everything at an OpenAI-compatible endpoint instead.
OPENAI_BASE_URL=

# ---- Support agent ------------------------------------------------------
# Powers the floating helper in the dashboard. This is our support cost, not
# the customer's — a founder who is stuck should not have to configure
# something to get unstuck. Leave blank and the widget says it is off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Marketing ----------------------------------------------------------
NEXT_PUBLIC_FOUNDER_NAME=
NEXT_PUBLIC_TWITTER_HANDLE=
NEXT_PUBLIC_SUPPORT_EMAIL=
